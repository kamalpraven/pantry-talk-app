# Public Supabase browser config (safe to expose; protected by RLS)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only Supabase service role key. Never expose to the browser.
# Not required for Milestone 1 runtime paths, but reserved for future privileged jobs/webhooks.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Existing PantryTalk server-only API keys
LOVABLE_API_KEY=
LINKUP_API_KEY=
IMAGE_PROXY_SECRET=
ALLOWED_ORIGINS=
